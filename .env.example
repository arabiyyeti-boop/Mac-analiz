# GEMINI_API_KEY: Gemini API Key for AI explanations (injected automatically in AI Studio)
GEMINI_API_KEY=""

# FOOTBALL_DATA_ORG_KEY: football-data.org API token (optional / free tier available)
FOOTBALL_DATA_ORG_KEY=""

# API_FOOTBALL_KEY: api-football.com / RapidAPI key (optional)
API_FOOTBALL_KEY=""

# APP_URL: The hosted URL of the application
APP_URL="http://localhost:3000"

# ALLOWED_ORIGINS: Comma-separated list of allowed CORS origins in production (e.g. https://domain1.com,https://domain2.com)
ALLOWED_ORIGINS=""

# API_RATE_LIMIT_PER_MINUTE: IP-based global rate limit for /api/* routes (default: 60)
API_RATE_LIMIT_PER_MINUTE="60"

# ANALYSIS_RATE_LIMIT_PER_MINUTE: IP-based rate limit for heavy analysis & AI routes (default: 20)
ANALYSIS_RATE_LIMIT_PER_MINUTE="20"
